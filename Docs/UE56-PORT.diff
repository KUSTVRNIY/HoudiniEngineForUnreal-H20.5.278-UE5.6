+	// ---------------------------------------------------------------------
+	// props MVP: export StaticMesh sockets of the first mesh-typed column
+	// as point attributes so Houdini can place props on sockets.
+	// Attributes (name / storage / tupleSize):
+	//   unreal_socket_count                int    1
+	//   unreal_socket_<i>_name             string 1
+	//   unreal_socket_<i>_pos              float  3   (cm, mesh local space)
+	//   unreal_socket_<i>_rot              float  3   (deg: pitch, yaw, roll)
+	// Plates without sockets simply get unreal_socket_count = 0.
+	// ---------------------------------------------------------------------
+	{
+		FProperty* MeshColumnProp = nullptr;
+		for (TFieldIterator<FProperty> ItProp(ScriptStruct); ItProp; ++ItProp)
+		{
+			FProperty* Prop = *ItProp;
+			UClass* PropClass = nullptr;
+			if (const FSoftObjectProperty* SoftProp = CastField<FSoftObjectProperty>(Prop))
+			{
+				PropClass = SoftProp->PropertyClass;
+			}
+			else if (const FObjectProperty* ObjProp = CastField<FObjectProperty>(Prop))
+			{
+				PropClass = ObjProp->PropertyClass;
+			}
+			if (PropClass && PropClass->IsChildOf(UStaticMesh::StaticClass()))
+			{
+				MeshColumnProp = Prop;
+				break;
+			}
+		}
+
+		if (MeshColumnProp)
+		{
+			const TMap<FName, uint8*>& RowMap = DataTable->GetRowMap();
+			TArray<UStaticMesh*> RowMeshes;
+			RowMeshes.Init(nullptr, NumRows);
+
+			for (int32 RowIdx = 0; RowIdx < NumRows; ++RowIdx)
+			{
+				uint8* const* RowMemoryPtr = RowMap.Find(RowNames[RowIdx]);
+				if (!RowMemoryPtr || !*RowMemoryPtr)
+				{
+					HOUDINI_LOG_MESSAGE(
+						TEXT("[props MVP] row '%s': row memory not found."), *RowNames[RowIdx].ToString());
+					continue;
+				}
+				uint8* RowMemory = *RowMemoryPtr;
+				if (const FSoftObjectProperty* SoftProp = CastField<FSoftObjectProperty>(MeshColumnProp))
+				{
+					const FSoftObjectPtr& SoftObject = SoftProp->GetPropertyValue(RowMemory);
+					RowMeshes[RowIdx] = Cast<UStaticMesh>(SoftObject.LoadSynchronous());
+				}
+				else if (const FObjectProperty* ObjProp = CastField<FObjectProperty>(MeshColumnProp))
+				{
+					RowMeshes[RowIdx] = Cast<UStaticMesh>(ObjProp->GetObjectPropertyValue(RowMemory));
+				}
+
+				if (!RowMeshes[RowIdx])
+				{
+					// Fallback: resolve by the same string the plugin otherwise exports.
+					const FString MeshPath = DataTableUtils::GetPropertyValueAsString(
+						MeshColumnProp, RowMemory, EDataTableExportFlags());
+					if (!MeshPath.IsEmpty())
+					{
+						RowMeshes[RowIdx] = Cast<UStaticMesh>(StaticLoadObject(
+							UStaticMesh::StaticClass(), nullptr, *MeshPath));
+					}
+					HOUDINI_LOG_MESSAGE(
+						TEXT("[props MVP] row '%s': soft/path load failed, path = '%s', resolved = %s"),
+						*RowNames[RowIdx].ToString(), *MeshPath,
+						RowMeshes[RowIdx] ? TEXT("yes") : TEXT("no"));
+				}
+			}
+
+			TArray<TArray<UStaticMeshSocket*>> RowSockets;
+			RowSockets.SetNum(NumRows);
+			int32 MaxSocketCount = 0;
+			for (int32 RowIdx = 0; RowIdx < NumRows; ++RowIdx)
+			{
+				if (RowMeshes[RowIdx])
+				{
+					TArray<UStaticMeshSocket*> Sockets;
+					for (const TObjectPtr<UStaticMeshSocket>& SocketPtr : RowMeshes[RowIdx]->Sockets)
+					{
+						if (UStaticMeshSocket* Socket = SocketPtr.Get())
+						{
+							Sockets.AddUnique(Socket);
+						}
+					}
+					// Fallback: some editor builds keep sockets outside the mesh array.
+					if (Sockets.Num() == 0)
+					{
+						for (TObjectIterator<UStaticMeshSocket> SocketIt; SocketIt; ++SocketIt)
+						{
+							UStaticMeshSocket* Socket = *SocketIt;
+							if (Socket && Socket->GetTypedOuter<UStaticMesh>() == RowMeshes[RowIdx])
+							{
+								Sockets.AddUnique(Socket);
+							}
+						}
+					}
+					RowSockets[RowIdx] = Sockets;
+					MaxSocketCount = FMath::Max(MaxSocketCount, Sockets.Num());
+					HOUDINI_LOG_MESSAGE(
+						TEXT("[props MVP] row '%s': mesh '%s', sockets = %d"),
+						*RowNames[RowIdx].ToString(), *RowMeshes[RowIdx]->GetName(), Sockets.Num());
+				}
+				else
+				{
+					HOUDINI_LOG_MESSAGE(
+						TEXT("[props MVP] row '%s': mesh could not be loaded."), *RowNames[RowIdx].ToString());
+				}
+			}
+
+			HOUDINI_LOG_MESSAGE(
+				TEXT("[props MVP] DataTable '%s': exported sockets, max per row = %d (mesh column '%s')."),
+				*DataTable->GetName(), MaxSocketCount, *MeshColumnProp->GetName());
+
+			HAPI_AttributeInfo SocketAttributeInfo;
+			FHoudiniApi::AttributeInfo_Init(&SocketAttributeInfo);
+			SocketAttributeInfo.count = NumRows;
+			SocketAttributeInfo.owner = HAPI_ATTROWNER_POINT;
+			SocketAttributeInfo.originalOwner = HAPI_ATTROWNER_INVALID;
+			SocketAttributeInfo.exists = true;
+
+			{
+				SocketAttributeInfo.tupleSize = 1;
+				SocketAttributeInfo.storage = HAPI_STORAGETYPE_INT;
+				HOUDINI_CHECK_ERROR_RETURN(FHoudiniApi::AddAttribute(
+					FHoudiniEngine::Get().GetSession(), InputNodeId, 0,
+					"unreal_socket_count", &SocketAttributeInfo), false);
+
+				TArray<int32> SocketCounts;
+				SocketCounts.SetNum(NumRows);
+				for (int32 RowIdx = 0; RowIdx < NumRows; ++RowIdx)
+				{
+					SocketCounts[RowIdx] = RowSockets[RowIdx].Num();
+				}
+				FHoudiniHapiAccessor Accessor(InputNodeId, 0, "unreal_socket_count");
+				HOUDINI_CHECK_RETURN(Accessor.SetAttributeData(SocketAttributeInfo, SocketCounts), false);
+			}
+
+			for (int32 SocketIdx = 0; SocketIdx < MaxSocketCount; ++SocketIdx)
+			{
+				const FString NameAttribute = FString::Printf(TEXT("unreal_socket_%d_name"), SocketIdx);
+				const FString PositionAttribute = FString::Printf(TEXT("unreal_socket_%d_pos"), SocketIdx);
+				const FString RotationAttribute = FString::Printf(TEXT("unreal_socket_%d_rot"), SocketIdx);
+
+				TArray<FString> SocketNames;
+				TArray<float> SocketPositions;
+				TArray<float> SocketRotations;
+				SocketNames.Reserve(NumRows);
+				SocketPositions.SetNum(NumRows * 3);
+				SocketRotations.SetNum(NumRows * 3);
+
+				for (int32 RowIdx = 0; RowIdx < NumRows; ++RowIdx)
+				{
+					const TArray<UStaticMeshSocket*>& Sockets = RowSockets[RowIdx];
+					if (Sockets.IsValidIndex(SocketIdx) && IsValid(Sockets[SocketIdx]))
+					{
+						const UStaticMeshSocket* Socket = Sockets[SocketIdx];
+						SocketNames.Add(Socket->SocketName.ToString());
+						SocketPositions[RowIdx * 3 + 0] = (float)Socket->RelativeLocation.X;
+						SocketPositions[RowIdx * 3 + 1] = (float)Socket->RelativeLocation.Y;
+						SocketPositions[RowIdx * 3 + 2] = (float)Socket->RelativeLocation.Z;
+						SocketRotations[RowIdx * 3 + 0] = (float)Socket->RelativeRotation.Pitch;
+						SocketRotations[RowIdx * 3 + 1] = (float)Socket->RelativeRotation.Yaw;
+						SocketRotations[RowIdx * 3 + 2] = (float)Socket->RelativeRotation.Roll;
+					}
+					else
+					{
+						SocketNames.Add(FString());
+						SocketPositions[RowIdx * 3 + 0] = 0.0f;
+						SocketPositions[RowIdx * 3 + 1] = 0.0f;
+						SocketPositions[RowIdx * 3 + 2] = 0.0f;
+						SocketRotations[RowIdx * 3 + 0] = 0.0f;
+						SocketRotations[RowIdx * 3 + 1] = 0.0f;
+						SocketRotations[RowIdx * 3 + 2] = 0.0f;
+					}
+				}
+
+				SocketAttributeInfo.tupleSize = 1;
+				SocketAttributeInfo.storage = HAPI_STORAGETYPE_STRING;
+				HOUDINI_CHECK_ERROR_RETURN(FHoudiniApi::AddAttribute(
+					FHoudiniEngine::Get().GetSession(), InputNodeId, 0,
+					TCHAR_TO_ANSI(*NameAttribute), &SocketAttributeInfo), false);
+				FHoudiniHapiAccessor NameAccessor(InputNodeId, 0, TCHAR_TO_ANSI(*NameAttribute));
+				HOUDINI_CHECK_RETURN(NameAccessor.SetAttributeData(SocketAttributeInfo, SocketNames), false);
+
+				SocketAttributeInfo.tupleSize = 3;
+				SocketAttributeInfo.storage = HAPI_STORAGETYPE_FLOAT;
+
+				HOUDINI_CHECK_ERROR_RETURN(FHoudiniApi::AddAttribute(
+					FHoudiniEngine::Get().GetSession(), InputNodeId, 0,
+					TCHAR_TO_ANSI(*PositionAttribute), &SocketAttributeInfo), false);
+				FHoudiniHapiAccessor PositionAccessor(InputNodeId, 0, TCHAR_TO_ANSI(*PositionAttribute));
+				HOUDINI_CHECK_RETURN(PositionAccessor.SetAttributeData(SocketAttributeInfo, SocketPositions), false);
+
+				HOUDINI_CHECK_ERROR_RETURN(FHoudiniApi::AddAttribute(
+					FHoudiniEngine::Get().GetSession(), InputNodeId, 0,
+					TCHAR_TO_ANSI(*RotationAttribute), &SocketAttributeInfo), false);
+				FHoudiniHapiAccessor RotationAccessor(InputNodeId, 0, TCHAR_TO_ANSI(*RotationAttribute));
+				HOUDINI_CHECK_RETURN(RotationAccessor.SetAttributeData(SocketAttributeInfo, SocketRotations), false);
+			}
+		}
+	}
+
 	HOUDINI_CHECK_ERROR_RETURN(FHoudiniEngineUtils::HapiCommitGeo(InputNodeId), false);
