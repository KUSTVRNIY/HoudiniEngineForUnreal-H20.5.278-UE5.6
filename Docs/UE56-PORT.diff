diff --git a/upstream/Source/HoudiniEngine/Private/HoudiniInstanceTranslator.cpp b/ported/Source/HoudiniEngine/Private/HoudiniInstanceTranslator.cpp
index e38b2aa..28b2f06 100644
--- a/upstream/Source/HoudiniEngine/Private/HoudiniInstanceTranslator.cpp
+++ b/ported/Source/HoudiniEngine/Private/HoudiniInstanceTranslator.cpp
@@ -3065,6 +3065,83 @@ FHoudiniInstanceTranslator::HapiGetInstanceTransforms(
 		FHoudiniEngineUtils::TranslateHapiTransform(InstanceTransform, OutInstancerUnrealTransforms[InstanceIdx]);
 	}
 
+	// UE5.6 port fix: when an HDA outputs several attribute-instancer parts (for example
+	// walls plus roof pieces), HAPI can report a zero scale for a part even though its
+	// point 'scale' attribute holds valid values. That makes instances invisible in UE.
+	// Recover the scale directly from the attribute in that case.
+	{
+		FHoudiniHapiAccessor ScaleAccessor(InHGPO.GeoId, InHGPO.PartId, HAPI_UNREAL_ATTRIB_INSTANCE_SCALE);
+		TArray<FVector3f> ScaleValues;
+		if (ScaleAccessor.GetAttributeData(HAPI_ATTROWNER_POINT, ScaleValues) &&
+			ScaleValues.Num() == OutInstancerUnrealTransforms.Num())
+		{
+			int32 RecoveredScaleCount = 0;
+			for (int32 InstanceIdx = 0; InstanceIdx < ScaleValues.Num(); InstanceIdx++)
+			{
+				FTransform& InstanceTransform = OutInstancerUnrealTransforms[InstanceIdx];
+				const FVector InstanceScale = InstanceTransform.GetScale3D();
+				const FVector3f& AttrScale = ScaleValues[InstanceIdx];
+				// Houdini is Y-up: swap Y/Z the same way TranslateHapiTransform does.
+				const FVector AttrScaleUE(AttrScale.X, AttrScale.Z, AttrScale.Y);
+				if (InstanceScale.IsNearlyZero() && !AttrScaleUE.IsNearlyZero())
+				{
+					InstanceTransform.SetScale3D(AttrScaleUE);
+					RecoveredScaleCount++;
+				}
+			}
+
+			if (RecoveredScaleCount > 0)
+			{
+				HOUDINI_LOG_WARNING(TEXT("[HoudiniInstanceTranslator] HapiGetInstanceTransforms: recovered %d zero instance scales from the 'scale' attribute (Geo %d, Part %d)."),
+					RecoveredScaleCount, InHGPO.GeoId, InHGPO.PartId);
+			}
+		}
+	}
+
+	// UE5.6 port fix (rotations): HAPI can also report an identity rotation for such a part,
+	// while the instancer points carry a valid 'orient' quaternion. Recover it as well.
+	{
+		FHoudiniHapiAccessor OrientAccessor(InHGPO.GeoId, InHGPO.PartId, "orient");
+		HAPI_AttributeInfo OrientInfo;
+		FHoudiniApi::AttributeInfo_Init(&OrientInfo);
+		if (OrientAccessor.GetInfo(OrientInfo, HAPI_ATTROWNER_POINT) &&
+			OrientInfo.tupleSize == 4 &&
+			OrientInfo.count == OutInstancerUnrealTransforms.Num())
+		{
+			TArray<float> OrientRaw;
+			OrientRaw.SetNum(OrientInfo.count * 4);
+			if (OrientAccessor.GetAttributeData(OrientInfo, OrientRaw.GetData(), 0, OrientInfo.count))
+			{
+				int32 RecoveredRotationCount = 0;
+				for (int32 InstanceIdx = 0; InstanceIdx < OrientInfo.count; InstanceIdx++)
+				{
+					FTransform& InstanceTransform = OutInstancerUnrealTransforms[InstanceIdx];
+					if (!InstanceTransform.GetRotation().IsIdentity())
+						continue;
+
+					const float qx = OrientRaw[InstanceIdx * 4 + 0];
+					const float qy = OrientRaw[InstanceIdx * 4 + 1];
+					const float qz = OrientRaw[InstanceIdx * 4 + 2];
+					const float qw = OrientRaw[InstanceIdx * 4 + 3];
+
+					// Houdini is Y-up and TranslateHapiTransform inverts W: same mapping here.
+					const FQuat OrientUE((double)qx, (double)qz, (double)qy, (double)-qw);
+					if (OrientUE.SizeSquared() > KINDA_SMALL_NUMBER && !OrientUE.IsIdentity())
+					{
+						InstanceTransform.SetRotation(OrientUE.GetNormalized());
+						RecoveredRotationCount++;
+					}
+				}
+
+				if (RecoveredRotationCount > 0)
+				{
+					HOUDINI_LOG_WARNING(TEXT("[HoudiniInstanceTranslator] HapiGetInstanceTransforms: recovered %d instance rotations from the 'orient' attribute (Geo %d, Part %d)."),
+						RecoveredRotationCount, InHGPO.GeoId, InHGPO.PartId);
+				}
+			}
+		}
+	}
+
 	return true;
 }
 
